{
  "name": "storywalker-studio",
  "version": "1.0.0",
  "private": true,
  "description": "An author-controlled studio for turning music history and life events into privacy-aware journey narratives.",
  "license": "MIT",
  "author": "Adina Pirjol",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:aurora-coast": "node --import tsx scripts/verify-demo.ts",
    "audit:public": "node scripts/audit-public-repo.mjs",
